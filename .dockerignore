# ============================================================
# Docker 构建时排除这些文件，镜像更小、构建更快
# ============================================================

# --- 数据目录（用 volume 挂载，不打进镜像）---
data/

# --- Python 缓存 ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# --- Git ---
.git/
.gitignore

# --- 环境配置（运行时用 .env 或环境变量注入）---
.env
.env.local

# --- 测试文件（运行时不需要）---
tests/

# --- 调试脚本（开发用，生产镜像不需要）---
scripts/

# --- 临时文件 ---
*.tmp
*.log
tmp_*.json
test_*.json
app.db

# --- 文档（运行时不需要）---
*.md
RAG准确率诊断报告.html
