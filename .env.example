# ===== 大模型主 (DeepSeek / OpenAI 兼容接口) =====
# 必填：替换为你的真实 API Key
LLM_API_KEY=sk-your-real-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 大模型辅 (备用模型，可选) =====
# 主模型不可用时自动降级到此模型
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# ===== 向量化模型 =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ===== 索引层 (ChromaDB) =====
INDEX_PERSIST_DIR=./data/chroma_db
INDEX_COLLECTION_NAME=mcu_qa
INDEX_STRUCTURED_DB_PATH=./data/structured.db

# ===== 检索层 =====
RETRIEVAL_TOP_K=18
RETRIEVAL_DENSE_WEIGHT=0.5
RETRIEVAL_SPARSE_WEIGHT=0.5
RETRIEVAL_RRF_K=60
RERANK_TOP_N=5

# ===== 生成层 =====
GENERATE_CONTEXT_MAX_CHARS=4000
GENERATE_FALLBACK_RULES_PATH=./config/fallback_rules.json

# ===== 文档分块 =====
CHUNK_MAX_CHARS=200
CHUNK_OVERLAP=20

# ===== API 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]

# ===== 通用 =====
LOG_LEVEL=INFO

# ===== 异步任务 (Celery + Redis) =====
# Redis 地址：WSL 中启动 redis-server 后默认监听 6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ===== 缓存 (Redis) =====
CACHE_REDIS_URL=redis://localhost:6379/2
CACHE_ANSWER_TTL=3600
CACHE_EMBED_TTL=86400

# ===== 关系型数据库 =====
# 开发环境用 SQLite，生产环境切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/rag_db
DATABASE_URL=sqlite:///./data/structured.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# ===== 认证 =====
# 生产环境必须改成随机字符串！泄露后任何人都能伪造 token
AUTH_SECRET_KEY=dev-only-secret-change-me-in-production
AUTH_TOKEN_TTL=28800
AUTH_REQUIRED=false

# ============================================================
# Docker 部署说明
# ============================================================
# 使用 docker compose up -d 一键启动时，以下变量会被 docker-compose.yml 覆盖：
#   - CELERY_BROKER_URL     → redis://redis:6379/0
#   - CELERY_RESULT_BACKEND → redis://redis:6379/1
#   - CACHE_REDIS_URL       → redis://redis:6379/2
#   - INDEX_PERSIST_DIR     → /app/data/chroma_db
#   - DATABASE_URL          → sqlite:////app/data/structured.db
#
# 你只需要确保 LLM_API_KEY 等大模型配置正确即可。
# 数据目录 ./data 会被挂载到容器内，embedding 模型、ChromaDB、SQLite 都持久化保存。